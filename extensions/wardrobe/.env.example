# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase when you deploy an Edge Function. You only need to set
# WD_ACCESS_KEY manually.
#
# Give this function its OWN key rather than sharing one across extensions.
# Supabase secrets are project-wide, so a shared key means every function in
# the project is unlocked by the same value: one leak exposes all of them, and
# rotating it takes every connector down at once. A per-function key also lets
# a browser-loaded surface — which must carry its key in the URL, and so leaks
# it into history and logs — hold a key that does NOT unlock the MCP servers.
#
# Prefer sending it as the `x-access-key` request header rather than `?key=`
# in the URL. Query strings end up in browser history, proxy logs, referrer
# headers and screenshots; headers mostly don't.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WD_ACCESS_KEY=your-wardrobe-access-key
# Dedicated HMAC secret for wd_eligibility run tokens (NOT the service role
# key). Any random string of 32+ bytes: `openssl rand -hex 32`.
WD_ELIGIBILITY_SECRET=your-eligibility-signing-secret
