# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase when you deploy an Edge Function. You only need to set
# MCP_ACCESS_KEY manually (reuse the same key as your other Open Brain
# extensions so one connection key works everywhere).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MCP_ACCESS_KEY=your-mcp-access-key
# Dedicated HMAC secret for wd_eligibility run tokens (NOT the service role
# key). Any random string of 32+ bytes: `openssl rand -hex 32`.
WD_ELIGIBILITY_SECRET=your-eligibility-signing-secret
